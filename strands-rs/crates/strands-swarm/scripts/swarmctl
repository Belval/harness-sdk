#!/usr/bin/env bash
# swarmctl: keep a named strands-swarm run alive in tmux.
#
# The supervisor restarts the run whenever it exits (it resumes from its saved state), restarts
# immediately into a new binary on a hot reload (exit 75), and rolls back to the previous binary
# when a new one fails within its trial (the first 10 minutes after it is installed or reloaded
# into). Repeated quick failures back off up to 5 minutes. Each rollback and crash loop is left in
# <run>/supervisor.notice, which the swarm mails to its root agent when it next starts. Only
# `swarmctl stop` ends it.
set -euo pipefail

STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
STATE="$STATE_HOME/strands-swarm"
SELF="$(readlink -f "$0")"
RELOAD_EXIT=75
# A binary installed (or reloaded into) less than this many seconds ago is rolled back on failure.
TRIAL_WINDOW="${SWARMCTL_TRIAL_WINDOW:-600}"
# A failed run shorter than this counts toward a crash loop.
QUICK_FAILURE=60
# Seconds before a restart, doubled per quick failure in a row up to MAX_DELAY.
RESTART_DELAY="${SWARMCTL_RESTART_DELAY:-5}"
MAX_DELAY=300
# stderr.log and supervisor.log are rotated to <log>.1 past this many bytes.
LOG_MAX="${SWARMCTL_LOG_MAX:-8388608}"

usage() {
  cat <<'EOF'
usage:
  swarmctl start <run> <binary> [strands-swarm args...]  start or resume <run> in tmux session swarm-<run>
  swarmctl resume <run>                                  start again with the saved binary and args
  swarmctl stop <run>                                    stop gracefully (state is kept)
  swarmctl attach <run>                                  open the TUI (detach with C-b d)
  swarmctl status                                        list runs
  swarmctl boot <run> | unboot <run>                     resume <run> after every reboot (crontab @reboot)
Environment for the swarm (credentials, PATH) is captured at `start` into <state>/<run>/env.
EOF
}

die() { echo "swarmctl: $*" >&2; exit 1; }
run_dir() { echo "$STATE/$1"; }
session() { echo "swarm-$1"; }
running() { tmux has-session -t "$(session "$1")" 2>/dev/null; }

# Append stdin to the log $1 line by line, rotating it to $1.1 whenever it passes LOG_MAX bytes.
capped_log() {
  local log="$1" line size
  size=$(stat -c %s "$log" 2>/dev/null || echo 0)
  while IFS= read -r line || [[ -n "$line" ]]; do
    if (( size > LOG_MAX )); then mv -f "$log" "$log.1"; size=0; fi
    printf '%s\n' "$line" >> "$log"
    size=$((size + ${#line} + 1))
  done
}

start() {
  local run="$1" binary="$2"; shift 2
  local dir; dir="$(run_dir "$run")"
  running "$run" && die "run $run is already running (swarmctl attach $run)"
  [[ -x "$binary" ]] || die "$binary is not executable"
  mkdir -p "$dir/bin"
  install -m 755 "$binary" "$dir/bin/current.new"
  # Like a reload, keep the binary that ran before for a rollback.
  [[ -f "$dir/bin/current" ]] && mv -f "$dir/bin/current" "$dir/bin/previous"
  mv "$dir/bin/current.new" "$dir/bin/current"
  # printf would write one empty argument for none.
  if (( $# )); then printf '%s\0' "$@"; fi > "$dir/args"
  # Keep the environment the swarm needs (credentials config, PATH for MCP servers) across reboots.
  { export -p | grep -E '^declare -x (PATH|HOME|USER|LANG|TERM|XDG_CONFIG_HOME|AWS_[A-Z_]*|CARGO_[A-Z_]*|RUSTUP_[A-Z_]*|QUICK_EVALS_[A-Z_]*|SSH_AUTH_SOCK)='; } > "$dir/env" || true
  chmod 600 "$dir/env"
  resume "$run"
}

resume() {
  local run="$1" dir; dir="$(run_dir "$run")"
  [[ -x "$dir/bin/current" ]] || die "no binary for run $run; use swarmctl start"
  running "$run" && die "run $run is already running"
  rm -f "$dir/stop"
  # A tmux server that is already running has its own environment, so the state home is passed on
  # (the supervisor and the swarm both find the run under it).
  tmux new-session -d -s "$(session "$run")" -x 220 -y 60 -e "XDG_STATE_HOME=$STATE_HOME" \
    "$SELF supervise $run"
  echo "run $run started: swarmctl attach $run"
}

# What exit code $1 means, for the logs and the notice.
describe() {
  case "$1" in
    70) echo "exited with code 70 (deadlock detected)" ;;
    71) echo "exited with code 71 (not up within its startup timeout)" ;;
    101) echo "panicked (exit code 101)" ;;
    *) if (( $1 > 128 )); then echo "was killed by signal $(( $1 - 128 ))"; else echo "exited with code $1"; fi ;;
  esac
}

# Give the pane back after a swarm that could not (killed, crashed): cooked mode, the main
# screen, the cursor, no mouse reporting. Otherwise what follows prints as a staircase over the TUI.
restore_terminal() {
  [[ -t 1 ]] || return 0
  stty sane 2>/dev/null || true
  printf '\e[?1000l\e[?1002l\e[?1003l\e[?1006l\e[?25h\e[?1049l'
}

# OOM kills so far in this process's cgroup (cgroup v2 memory.events, which the swarm shares);
# empty when they cannot be counted.
oom_kills() {
  local events="${SWARMCTL_MEMORY_EVENTS:-}"
  [[ -n "$events" ]] || events="/sys/fs/cgroup$(sed -n 's/^0:://p' /proc/self/cgroup 2>/dev/null)/memory.events"
  awk '$1 == "oom_kill" { print $2 }' "$events" 2>/dev/null || true
}

supervise() {
  local run="$1" dir; dir="$(run_dir "$run")"
  local args=() failures=0 i
  mapfile -d '' args < "$dir/args"
  # shellcheck disable=SC1091
  source "$dir/env"
  cd "$HOME"
  note() { echo "$(date -Is) $*" | capped_log "$dir/supervisor.log"; }
  # Appended to supervisor.notice, for the swarm to mail its root agent when it next starts.
  notice() { { echo "$(date -Is) $*"; echo "Last lines of $dir/stderr.log:"; tail -n 8 "$dir/stderr.log" 2>/dev/null || true; echo; } >> "$dir/supervisor.notice"; }
  while [[ ! -f "$dir/stop" ]]; do
    local started installed code ooms id
    started=$(date +%s)
    # A binary's trial starts when it first runs, not when it was installed: an idle reload
    # waits, and a stop can come in between. bin/started names the binary started last; without
    # one (an older supervisor's run) the install time stands.
    id=$(stat -c '%i %Y' "$dir/bin/current" 2>/dev/null || true)
    if [[ -f "$dir/bin/started" && "$id" != "$(cat "$dir/bin/started")" ]]; then
      touch "$dir/bin/current" 2>/dev/null || true
      id=$(stat -c '%i %Y' "$dir/bin/current" 2>/dev/null || true)
    fi
    echo "$id" > "$dir/bin/started"
    installed=$(stat -c %Y "$dir/bin/current" 2>/dev/null || echo 0)
    ooms=$(oom_kills)
    # stderr goes through capped_log (fd 3 keeps stdout on the terminal); the pipeline returns
    # only once the log has every line, so the tail below is complete.
    set +e
    { "$dir/bin/current" --run "$run" "${args[@]}" 2>&1 1>&3 3>&- | capped_log "$dir/stderr.log"; } 3>&1
    code=${PIPESTATUS[0]}
    set -e
    restore_terminal
    [[ -f "$dir/stop" ]] && break
    local now elapsed why delay
    now=$(date +%s); elapsed=$((now - started))
    if [[ $code -eq $RELOAD_EXIT ]]; then
      failures=0
      note "reload"
      continue
    fi
    note "exited code=$code after ${elapsed}s"
    if (( code == 0 )); then
      failures=0
      sleep "$RESTART_DELAY"
      continue
    fi
    # The swarm never sends itself SIGKILL or SIGTERM, so one is somebody else's doing and no
    # verdict on the binary: it is restarted, its trial (if any) running on. SIGKILL from the
    # OOM killer, or when OOM kills cannot be counted, still fails the binary.
    if (( code == 128 + 15 )) || { (( code == 128 + 9 )) && [[ -n "$ooms" && "$(oom_kills)" == "$ooms" ]]; }; then
      note "killed from outside (signal $((code - 128))); restarting"
      echo "$(date -Is) strands-swarm was killed from outside (signal $((code - 128))) after ${elapsed}s; restarting"
      sleep "$RESTART_DELAY"
      continue
    fi
    why=$(describe "$code")
    (( code == 128 + 9 )) && [[ -n "$ooms" ]] && why="was killed by the OOM killer"
    if (( elapsed < QUICK_FAILURE )); then failures=$((failures + 1)); else failures=1; fi
    # Shown in the tmux pane, which is what `swarmctl attach` shows while the swarm is down.
    echo "$(date -Is) strands-swarm $why after ${elapsed}s; last lines of $dir/stderr.log:"
    tail -n 8 "$dir/stderr.log" 2>/dev/null || true
    if (( now - installed < TRIAL_WINDOW )) && [[ -x "$dir/bin/previous" ]] \
      && mv -f "$dir/bin/current" "$dir/bin/failed" && mv "$dir/bin/previous" "$dir/bin/current"; then
      note "rolled back to the previous binary"
      notice "The new binary $why ${elapsed}s after it started, so the supervisor rolled back to the previous binary (the failed one is $dir/bin/failed)."
      echo "rolled back to the previous binary"
      failures=0
      sleep "$RESTART_DELAY"
      continue
    fi
    delay=$RESTART_DELAY
    for (( i = 1; i < failures && delay < MAX_DELAY; i++ )); do delay=$((delay * 2)); done
    (( delay > MAX_DELAY )) && delay=$MAX_DELAY
    if (( failures == 3 )); then
      note "crash loop: $failures quick failures in a row"
      notice "The swarm failed $failures times in a row, each within ${QUICK_FAILURE}s of starting (last: $why); nothing to roll back to, so the supervisor keeps restarting it with a growing delay (at most ${MAX_DELAY}s)."
    fi
    echo "restarting in ${delay}s"
    sleep "$delay"
  done
}

stop() {
  local run="$1" dir; dir="$(run_dir "$run")"
  touch "$dir/stop"
  running "$run" || { echo "run $run is not running"; return; }
  # Ctrl-C quits the TUI (and headless mode) cleanly: state is saved and agents stop.
  tmux send-keys -t "$(session "$run")" C-c
  for _ in $(seq 30); do running "$run" || { echo "run $run stopped"; return; }; sleep 1; done
  tmux kill-session -t "$(session "$run")"
  echo "run $run killed after 30s (state is saved continuously)"
}

status() {
  [[ -d "$STATE" ]] || { echo "no runs"; return; }
  for dir in "$STATE"/*/; do
    local run; run="$(basename "$dir")"
    [[ -f "$dir/swarm.json" ]] || continue
    local state="stopped"; running "$run" && state="running"
    local agents; agents=$(python3 -I -c 'import json,sys; a=json.load(open(sys.argv[1]))["agents"]; print(len([x for x in a if x["status"]!="cancelled"]), "live /", len(a))' "$dir/swarm.json")
    local last=""
    [[ -f "$dir/supervisor.log" ]] && last="; supervisor: $(tail -n 1 "$dir/supervisor.log")"
    echo "$run: $state, agents $agents$last"
  done
}

# The current crontab minus `line`; empty (not an error) when there is no crontab yet.
crontab_without() { { crontab -l 2>/dev/null || true; } | { grep -vF "$1" || true; }; }

# The crontab line that resumes run $1, under the custom state home if one is set.
boot_line() { echo "@reboot ${XDG_STATE_HOME:+XDG_STATE_HOME=$XDG_STATE_HOME }$SELF resume $1"; }

boot() {
  local line; line="$(boot_line "$1")"
  { crontab_without "$line"; echo "$line"; } | crontab -
  echo "run $1 will resume after reboot"
}

unboot() {
  local line; line="$(boot_line "$1")"
  crontab_without "$line" | crontab -
}

cmd="${1:-}"; shift || true
case "$cmd" in
  start) (( $# >= 2 )) || { usage; exit 1; }; start "$@" ;;
  resume) resume "$1" ;;
  supervise) supervise "$1" ;;
  log) capped_log "$1" ;;
  stop) stop "$1" ;;
  attach) tmux attach -t "$(session "$1")" ;;
  status) status ;;
  boot) boot "$1" ;;
  unboot) unboot "$1" ;;
  *) usage; exit 1 ;;
esac
